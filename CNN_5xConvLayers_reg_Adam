# Функція для аугментації даних
def augment_data(image):
    # Випадкове горизонтальне відображення
    if np.random.random() > 0.5:
        image = np.fliplr(image)

    # Випадкове обертання на невеликий кут
    angle = np.random.uniform(-15, 15)
    image = rotate_image(image, angle)

    # Випадкова зміна яскравості
    brightness = np.random.uniform(0.8, 1.2)
    image = np.clip(image * brightness, 0, 1)

    return image


def rotate_image(image, angle):
    # Конвертуємо кут в радіани
    rads = np.deg2rad(angle)

    # Створюємо матрицю повороту
    c, s = np.cos(rads), np.sin(rads)
    rot_mat = np.array([[c, -s, 0],
                        [s, c, 0],
                        [0, 0, 1]])

    # Застосовуємо поворот
    center = np.array(image.shape[:2]) / 2
    rot_img = np.zeros_like(image)

    for i in range(image.shape[0]):
        for j in range(image.shape[1]):
            src_pos = np.array([i - center[0], j - center[1], 1])
            dst_pos = rot_mat.dot(src_pos)
            dst_i, dst_j = int(dst_pos[0] + center[0]), int(dst_pos[1] + center[1])

            if 0 <= dst_i < image.shape[0] and 0 <= dst_j < image.shape[1]:
                rot_img[i, j] = image[dst_i, dst_j]

    return rot_img


def create_filters():
    # Фільтри першого шару (16 простих фільтрів)
    filters1 = np.array([
